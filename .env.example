# Copy to .env and change all secrets before deploying.
# docker compose automatically loads .env from the project root.

# --- Security (required in production) ---
SAM3_INTERNAL_KEY=change-me-sam-internal-key
MASKFLOW_ADMIN_API_KEY=change-me-admin-api-key

# Comma-separated frontend origins for CORS
MASKFLOW_CORS_ORIGINS=http://localhost:3000

# Set to true only for local billing/plan testing (never in production)
# MASKFLOW_BILLING_DEV_MODE=true

# Login rate limit (optional overrides)
# MASKFLOW_LOGIN_MAX_ATTEMPTS=5
# MASKFLOW_LOGIN_LOCKOUT_MINUTES=15

# --- Database ---
MYSQL_ROOT_PASSWORD=change-me-mysql-root
MYSQL_PASSWORD=change-me-mysql-user

# --- MinIO ---
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me-minio
