# Copy to .env and change all secrets before deploying.
# docker compose automatically loads .env from the project root.
# docker compose up will fail if required variables are missing.

# --- Security (required for Docker / Production) ---
# Use unique values at least 16 characters; do not use maskflow-*-dev-key defaults.
SAM3_INTERNAL_KEY=change-me-sam-internal-key-min16
MASKFLOW_ADMIN_API_KEY=change-me-admin-api-key-min16

# Comma-separated frontend origins for CORS
MASKFLOW_CORS_ORIGINS=http://localhost:3000

# Set to true only for local billing/plan testing (never in production)
# MASKFLOW_BILLING_DEV_MODE=true

# Login rate limit (optional overrides)
# MASKFLOW_LOGIN_MAX_ATTEMPTS=5
# MASKFLOW_LOGIN_LOCKOUT_MINUTES=15

# Upload / AI inference (optional overrides)
# MASKFLOW_MAX_UPLOAD_BYTES=52428800
# MASKFLOW_SAM_MAX_CONCURRENT=2

# --- Database ---
MYSQL_ROOT_PASSWORD=change-me-mysql-root-min16
MYSQL_PASSWORD=change-me-mysql-user-min16

# --- MinIO ---
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me-minio-password-min16
